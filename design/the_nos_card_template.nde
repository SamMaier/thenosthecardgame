; The Nos - minimalist photo card starter for nanDECK
; Keep this .nde file and the linked CSV in the same folder.
; Put each real-life card photo in the path listed in the Image column.

UNIT = INCH
; Print geometry:
; bleed canvas: 2.74 x 3.74 in
; cut line:     x=0.12..2.62, y=0.12..3.62
; safe area:    x=0.22..2.52, y=0.22..3.52 (2.3 x 3.3 in)
CARDSIZE = 2.74, 3.74
DPI = 600

; Palette: warm paper, charcoal ink, restrained cedar accent.
[paper] = #F5F0E8
[ink] = #1F2528
[shade] = #1F2528
[accent] = #C65532
[rule] = #D9D0C3

; The linked CSV must have these columns:
; Title, Tags, Cost, Effect, Flavor text, Image
; Tags is a quoted ~-delimited list, for example:
; "Board Game~Social~Outdoors" or "Item". Up to three tag icons are shown.
; The main text fields use HTMLTEXT so future image keys can be embedded in them.
HTMLFONT = effect_text, Montserrat, 5.5, , [ink]
HTMLFONT = flavor_text, Montserrat, 5, I, [ink]
LINKUNI = ON

; Inline glyphs for HTMLTEXT.  Put the parenthesized key in a CSV text field,
; for example: "Take a walk (tree)".  The PNG companions are in glyphs/png.
HTMLIMAGE = , "(boardgame)", "glyphs/png/boardgame.png", 0.11, 0.11, PB
HTMLIMAGE = , "(before)", "glyphs/png/arrow_left.png", 0.11, 0.11, PB
HTMLIMAGE = , "(after)", "glyphs/png/arrow_right.png", 0.11, 0.11, PB
HTMLIMAGE = , "(card)", "glyphs/png/card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(energy)", "glyphs/png/energy.png", 0.11, 0.11, PB
HTMLIMAGE = , "(exercise)", "glyphs/png/exercise.png", 0.11, 0.11, PB
HTMLIMAGE = , "(food)", "glyphs/png/food.png", 0.11, 0.11, PB
HTMLIMAGE = , "(indoors)", "glyphs/png/indoors.png", 0.11, 0.11, PB
HTMLIMAGE = , "(item)", "glyphs/png/item.png", 0.11, 0.11, PB
HTMLIMAGE = , "(relax)", "glyphs/png/relax.png", 0.11, 0.11, PB
HTMLIMAGE = , "(social)", "glyphs/png/social.png", 0.11, 0.11, PB
HTMLIMAGE = , "(suitcase)", "glyphs/png/suitcase.png", 0.11, 0.11, PB
HTMLIMAGE = , "(fun)", "glyphs/png/fun.png", 0.11, 0.11, PB
HTMLIMAGE = , "(outdoors)", "glyphs/png/outdoors.png", 0.11, 0.11, PB
HTMLIMAGE = , "(trunk)", "glyphs/png/trunk.png", 0.11, 0.11, PB
HTMLIMAGE = , "(EXERCISE_card)", "glyphs/png/exercise_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(FOOD_card)", "glyphs/png/food_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(INDOORS_card)", "glyphs/png/indoors_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(ITEM_card)", "glyphs/png/item_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(RELAX_card)", "glyphs/png/relax_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(SOCIAL_card)", "glyphs/png/social_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(OUTDOORS_card)", "glyphs/png/outdoors_card.png", 0.11, 0.11, PB

; Double-size copies of the tag glyphs for the tag row.
HTMLIMAGE = , "(tag_outdoors)", "glyphs/png/outdoors.png", 0.22, 0.22, PB
HTMLIMAGE = , "(tag_indoors)", "glyphs/png/indoors.png", 0.22, 0.22, PB
HTMLIMAGE = , "(tag_relax)", "glyphs/png/relax.png", 0.22, 0.22, PB
HTMLIMAGE = , "(tag_boardgame)", "glyphs/png/boardgame.png", 0.22, 0.22, PB
HTMLIMAGE = , "(tag_item)", "glyphs/png/item.png", 0.22, 0.22, PB
HTMLIMAGE = , "(tag_social)", "glyphs/png/social.png", 0.22, 0.22, PB
HTMLIMAGE = , "(tag_food)", "glyphs/png/food.png", 0.22, 0.22, PB
HTMLIMAGE = , "(tag_exercise)", "glyphs/png/exercise.png", 0.22, 0.22, PB

LINKCSV = UTF8
;LINK = "test.csv"
LINK = "real_card_data.csv"

; Split the per-card Tags list into the three visible tag-icon slots.
[tag1] = TOKENIZESEQ([Tags], 1, ~)
[tag2] = TOKENIZESEQ([Tags], 2, ~)
[tag3] = TOKENIZESEQ([Tags], 3, ~)

; Base card.
RECTANGLE = , 0, 0, 2.74, 3.74, [paper]

; Full-bleed photo: it reaches the top and both side borders.
; PC keeps the aspect ratio and crops the excess to fill the frame.
; The badge is intentionally drawn later, so it sits over the photo.
IMAGE = , [Image], 0, 0, 2.74, 2.00, 0, PC

; Information panel.
; It is allowed to extend into the bleed because it is plain paper.
RECTANGLE = , 0, 2.00, 2.74, 1.74, [paper]

; Energy cost badge - top-left, over the image.
; Its entire bounding box is inside the safe area.
; Draw the dark-grey fill at 20% opacity, then the paper-colored outline.
LAYER = 20
ROUNDRECT = , 0.30, 0.30, 0.32, 0.32, [shade], [shade], 0.001, 0.06, 0.06, R
ENDLAYER
ROUNDRECT = , 0.30, 0.30, 0.32, 0.32, [paper], EMPTY, 0.012, 0.06, 0.06, R
FONT = Montserrat, 11, BT, [paper]
TEXT = , [Cost], 0.30, 0.30, 0.32, 0.32, center, center, 0, 100, , , , 100, 110

; Title, tags, effect, and flavor text.
; T makes the TEXT background transparent instead of the default white.
FONT = Montserrat, 13, BT, [ink]
TEXT = , [Title], 0.32, 2.04, 2.18, 0.20, left, center, 0, 100, , , , 100, 100

; Each tag is a 0.22-inch HTMLIMAGE glyph, twice the inline-text size.
; Empty slots and unknown tags simply draw nothing.
HTMLTEXT = LABELRANGE([tag1], Outdoors), "(tag_outdoors)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Indoors), "(tag_indoors)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Relax), "(tag_relax)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Board Game), "(tag_boardgame)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Item), "(tag_item)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Social), "(tag_social)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Food), "(tag_food)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Exercise), "(tag_exercise)", 0.32, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Outdoors), "(tag_outdoors)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Indoors), "(tag_indoors)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Relax), "(tag_relax)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Board Game), "(tag_boardgame)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Item), "(tag_item)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Social), "(tag_social)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Food), "(tag_food)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Exercise), "(tag_exercise)", 0.92, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Outdoors), "(tag_outdoors)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Indoors), "(tag_indoors)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Relax), "(tag_relax)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Board Game), "(tag_boardgame)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Item), "(tag_item)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Social), "(tag_social)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Food), "(tag_food)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Exercise), "(tag_exercise)", 1.52, 2.24, 0.22, 0.22, [paper], 0, ET, 100, effect_text

RECTANGLE = , 0.32, 2.52, 0.26, 0.015, [accent]

; HTMLTEXT wraps long rules automatically and leaves room for future
; HTMLIMAGE/HTMLKEY replacements embedded in the Effect field.
HTMLTEXT = , [Effect], 0.32, 2.62, 2.18, 0.56, [paper], 0, ET, 100, effect_text

; Optional flavor text below the effect, set in italics.
HTMLTEXT = , [Flavor text], 0.32, 3.18, 2.18, 0.32, [paper], 0, ET, 100, flavor_text

; Draw a quiet border on the safe-area boundary, last.
; It is decorative only; all critical content is inside it.
ROUNDRECT = , 0.22, 0.22, 2.30, 3.30, [ink], EMPTY, 0.015, 0.08, 0.08, R
