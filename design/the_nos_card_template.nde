; The Nos - minimalist photo card starter for nanDECK
; Keep this .nde file and the linked CSV in the same folder.
; Put each real-life card photo in the path listed in the Image column.

UNIT = INCH
; Print geometry:
; bleed canvas: 2.74 x 3.74 in
; cut line:     x=0.12..2.62, y=0.12..3.62
; safe area:    x=0.22..2.52, y=0.22..3.52 (2.3 x 3.3 in)
CARDSIZE = 2.74, 3.74
DPI = 600

; Palette: light card backing, dark card backing, and card-type glyph colors.
[paper] = #ECE3CE
[ink] = #2B221B
[shade] = #3B312B
[dark_accent] = #F5EFE6
[accent] = #2B221B
[rule] = #2B221B

; The linked CSV must have these columns:
; Title, Tags, Cost, Effect, Flavor text, Image
; Tags is a quoted ~-delimited list, for example:
; "Board Game~Social~Outdoors" or "Item". Up to three tag icons are shown.
; The main text fields use HTMLTEXT so future image keys can be embedded in them.
HTMLFONT = effect_text, Montserrat, 5.5, , [ink]
HTMLFONT = flavor_text, Montserrat, 5, I, [ink]
LINKUNI = ON

; Inline glyphs for HTMLTEXT.  Put the parenthesized key in a CSV text field,
; for example: "Take a walk (tree)".  The PNG companions are in glyphs/png.
HTMLIMAGE = , "(boardgame)", "glyphs/png/boardgame.png", 0.11, 0.11, PB
HTMLIMAGE = , "(before)", "glyphs/png/arrow_left.png", 0.07, 0.07, PB, 0, 0, 0, 0, 0.02
HTMLIMAGE = , "(after)", "glyphs/png/arrow_right.png", 0.07, 0.07, PB, 0, 0, 0, 0, 0.02
HTMLIMAGE = , "(card)", "glyphs/png/card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(energy)", "glyphs/png/energy.png", 0.11, 0.11, PB
HTMLIMAGE = , "(exercise)", "glyphs/png/exercise.png", 0.11, 0.11, PB
HTMLIMAGE = , "(food)", "glyphs/png/food.png", 0.11, 0.11, PB
HTMLIMAGE = , "(indoors)", "glyphs/png/indoors.png", 0.11, 0.11, PB
HTMLIMAGE = , "(item)", "glyphs/png/item.png", 0.11, 0.11, PB
HTMLIMAGE = , "(relax)", "glyphs/png/relax.png", 0.11, 0.11, PB
HTMLIMAGE = , "(social)", "glyphs/png/social.png", 0.11, 0.11, PB
HTMLIMAGE = , "(suitcase)", "glyphs/png/suitcase.png", 0.11, 0.11, PB
HTMLIMAGE = , "(fun)", "glyphs/png/fun.png", 0.11, 0.11, PB
HTMLIMAGE = , "(outdoors)", "glyphs/png/outdoors.png", 0.11, 0.11, PB
HTMLIMAGE = , "(trunk)", "glyphs/png/trunk.png", 0.11, 0.11, PB
HTMLIMAGE = , "(EXERCISE_card)", "glyphs/png/exercise_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(FOOD_card)", "glyphs/png/food_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(INDOORS_card)", "glyphs/png/indoors_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(ITEM_card)", "glyphs/png/item_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(RELAX_card)", "glyphs/png/relax_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(SOCIAL_card)", "glyphs/png/social_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(OUTDOORS_card)", "glyphs/png/outdoors_card.png", 0.11, 0.11, PB
HTMLIMAGE = , "(BOARDGAME_card)", "glyphs/png/boardgame_card.png", 0.11, 0.11, PB

; Double-size copies of the tag glyphs for the tag row.
HTMLIMAGE = , "(tag_outdoors)", "glyphs/png/outdoors.png", 0.187, 0.187, PB
HTMLIMAGE = , "(tag_indoors)", "glyphs/png/indoors.png", 0.187, 0.187, PB
HTMLIMAGE = , "(tag_relax)", "glyphs/png/relax.png", 0.187, 0.187, PB
HTMLIMAGE = , "(tag_boardgame)", "glyphs/png/boardgame.png", 0.187, 0.187, PB
HTMLIMAGE = , "(tag_item)", "glyphs/png/item.png", 0.187, 0.187, PB
HTMLIMAGE = , "(tag_social)", "glyphs/png/social.png", 0.187, 0.187, PB
HTMLIMAGE = , "(tag_food)", "glyphs/png/food.png", 0.187, 0.187, PB
HTMLIMAGE = , "(tag_exercise)", "glyphs/png/exercise.png", 0.187, 0.187, PB

LINKCSV = UTF8
LINK = "test.csv"
;LINK = "real_card_data.csv"

; Split the per-card Tags list into the three visible tag-icon slots.
[tag1] = TOKENIZESEQ([Tags], 1, ~)
[tag2] = TOKENIZESEQ([Tags], 2, ~)
[tag3] = TOKENIZESEQ([Tags], 3, ~)

; Tag circles use their category color blended 50% toward white.
[tag_outdoors_bg] = #A5B5A1
[tag_indoors_bg] = #C6A99C
[tag_relax_bg] = #BDC1D3
[tag_board_game_bg] = #969FAA
[tag_item_bg] = #B7BBBE
[tag_social_bg] = #EDCD9C
[tag_food_bg] = #E4AD99
[tag_exercise_bg] = #D9A5B0

; Base card.
RECTANGLE = , 0, 0, 2.74, 3.74, [paper]

; Photo spans exactly the cut-line width (x=0.12..2.62) and extends to the top.
; C preserves the aspect ratio and fills the frame, cropping the excess.
; I applies EXIF rotation first, so portrait photos fill the width and crop
; at the top and bottom even when orientation is stored in the photo metadata.
; The badge is intentionally drawn later, so it sits over the photo.
IMAGE = , [Image], 0.12, 0, 2.50, 2.00, 0, CI

; Information panel.
; It is allowed to extend into the bleed because it is plain paper.
RECTANGLE = , 0, 2.00, 2.74, 1.74, [paper]

; Energy cost badge - top-left, over the image.
; Its entire bounding box is inside the safe area.
; Dark card-back fill with the light dark-backing accent for its outline and text.
LAYER = 20
ROUNDRECT = , 0.30, 0.30, 0.32, 0.32, [shade], [shade], 0.001, 0.06, 0.06, R
ENDLAYER
ROUNDRECT = , 0.30, 0.30, 0.32, 0.32, [dark_accent], EMPTY, 0.012, 0.06, 0.06, R
FONT = Montserrat, 11, BT, [dark_accent]
TEXT = , [Cost], 0.30, 0.30, 0.32, 0.32, center, center, 0, 100, , , , 100, 110

; Title, tags, effect, and flavor text.
; T makes the TEXT background transparent instead of the default white.
FONT = Montserrat, 13, BT, [ink]
TEXT = , [Title], 0.32, 2.04, 2.18, 0.20, left, center, 0, 100, , , , 100, 100

; Each 0.22-inch tag circle uses a 50%-to-white category tint; its icon is
; 0.187 inch (1.7x inline size).
; Empty slots and unknown tags simply draw nothing.
ELLIPSE = LABELRANGE([tag1], Outdoors), 0.32, 2.24, 0.22, 0.22, [tag_outdoors_bg], [tag_outdoors_bg], 0.001
ELLIPSE = LABELRANGE([tag1], Indoors), 0.32, 2.24, 0.22, 0.22, [tag_indoors_bg], [tag_indoors_bg], 0.001
ELLIPSE = LABELRANGE([tag1], Relax), 0.32, 2.24, 0.22, 0.22, [tag_relax_bg], [tag_relax_bg], 0.001
ELLIPSE = LABELRANGE([tag1], Board Game), 0.32, 2.24, 0.22, 0.22, [tag_board_game_bg], [tag_board_game_bg], 0.001
ELLIPSE = LABELRANGE([tag1], Item), 0.32, 2.24, 0.22, 0.22, [tag_item_bg], [tag_item_bg], 0.001
ELLIPSE = LABELRANGE([tag1], Social), 0.32, 2.24, 0.22, 0.22, [tag_social_bg], [tag_social_bg], 0.001
ELLIPSE = LABELRANGE([tag1], Food), 0.32, 2.24, 0.22, 0.22, [tag_food_bg], [tag_food_bg], 0.001
ELLIPSE = LABELRANGE([tag1], Exercise), 0.32, 2.24, 0.22, 0.22, [tag_exercise_bg], [tag_exercise_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Outdoors), 0.92, 2.24, 0.22, 0.22, [tag_outdoors_bg], [tag_outdoors_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Indoors), 0.92, 2.24, 0.22, 0.22, [tag_indoors_bg], [tag_indoors_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Relax), 0.92, 2.24, 0.22, 0.22, [tag_relax_bg], [tag_relax_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Board Game), 0.92, 2.24, 0.22, 0.22, [tag_board_game_bg], [tag_board_game_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Item), 0.92, 2.24, 0.22, 0.22, [tag_item_bg], [tag_item_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Social), 0.92, 2.24, 0.22, 0.22, [tag_social_bg], [tag_social_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Food), 0.92, 2.24, 0.22, 0.22, [tag_food_bg], [tag_food_bg], 0.001
ELLIPSE = LABELRANGE([tag2], Exercise), 0.92, 2.24, 0.22, 0.22, [tag_exercise_bg], [tag_exercise_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Outdoors), 1.52, 2.24, 0.22, 0.22, [tag_outdoors_bg], [tag_outdoors_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Indoors), 1.52, 2.24, 0.22, 0.22, [tag_indoors_bg], [tag_indoors_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Relax), 1.52, 2.24, 0.22, 0.22, [tag_relax_bg], [tag_relax_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Board Game), 1.52, 2.24, 0.22, 0.22, [tag_board_game_bg], [tag_board_game_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Item), 1.52, 2.24, 0.22, 0.22, [tag_item_bg], [tag_item_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Social), 1.52, 2.24, 0.22, 0.22, [tag_social_bg], [tag_social_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Food), 1.52, 2.24, 0.22, 0.22, [tag_food_bg], [tag_food_bg], 0.001
ELLIPSE = LABELRANGE([tag3], Exercise), 1.52, 2.24, 0.22, 0.22, [tag_exercise_bg], [tag_exercise_bg], 0.001
HTMLTEXT = LABELRANGE([tag1], Outdoors), "(tag_outdoors)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Indoors), "(tag_indoors)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Relax), "(tag_relax)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Board Game), "(tag_boardgame)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Item), "(tag_item)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Social), "(tag_social)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Food), "(tag_food)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag1], Exercise), "(tag_exercise)", 0.3365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Outdoors), "(tag_outdoors)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Indoors), "(tag_indoors)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Relax), "(tag_relax)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Board Game), "(tag_boardgame)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Item), "(tag_item)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Social), "(tag_social)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Food), "(tag_food)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag2], Exercise), "(tag_exercise)", 0.9365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Outdoors), "(tag_outdoors)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Indoors), "(tag_indoors)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Relax), "(tag_relax)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Board Game), "(tag_boardgame)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Item), "(tag_item)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Social), "(tag_social)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Food), "(tag_food)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text
HTMLTEXT = LABELRANGE([tag3], Exercise), "(tag_exercise)", 1.5365, 2.2565, 0.187, 0.187, [paper], 0, ET, 100, effect_text

RECTANGLE = , 0.32, 2.52, 0.26, 0.015, [accent]

; HTMLTEXT wraps long rules automatically and leaves room for future
; HTMLIMAGE/HTMLKEY replacements embedded in the Effect field.
HTMLTEXT = , [Effect], 0.32, 2.62, 2.18, 0.56, [paper], 0, ET, 100, effect_text

; Optional flavor text below the effect, set in italics.
HTMLTEXT = , [Flavor text], 0.32, 3.18, 2.18, 0.32, [paper], 0, ET, 100, flavor_text

; Draw a quiet border on the safe-area boundary, last.
; It is decorative only; all critical content is inside it.
ROUNDRECT = , 0.22, 0.22, 2.30, 3.30, [ink], EMPTY, 0.015, 0.08, 0.08, R
