; The Nos - minimalist photo card starter for nanDECK
; Keep this .nde file and the linked CSV in the same folder.
; Put each real-life card photo in the path listed in the Image column.

UNIT = INCH
; Print geometry:
; bleed canvas: 2.74 x 3.74 in
; cut line:     x=0.12..2.62, y=0.12..3.62
; safe area:    x=0.22..2.52, y=0.22..3.52 (2.3 x 3.3 in)
CARDSIZE = 2.74, 3.74
DPI = 600

; Palette: warm paper, charcoal ink, restrained cedar accent.
[paper] = #F5F0E8
[ink] = #1F2528
[shade] = #1F2528
[accent] = #C65532
[rule] = #D9D0C3

; The linked CSV must have these columns:
; Title, Tags, Cost, Effect, Flavor, Image
; Tags is a quoted ~-delimited list, for example:
; "Board Game~Social~Outdoors" or "Item". Up to three tags are shown.
; The main text fields use HTMLTEXT so future image keys can be embedded in them.
HTMLFONT = effect_text, Montserrat, 5.5, , [ink]
HTMLFONT = flavor_text, Montserrat, 5, I, [ink]
LINKUNI = ON

; Inline glyphs for HTMLTEXT.  Put the parenthesized key in a CSV text field,
; for example: "Take a walk (tree)".  The PNG companions are in glyphs/png.
HTMLIMAGE = , "(boardgame)", "glyphs/png/boardgame.png", 0.11, 0.11, PB
HTMLIMAGE = , "(energy)", "glyphs/png/energy.png", 0.11, 0.11, PB
HTMLIMAGE = , "(exercise)", "glyphs/png/exercise.png", 0.11, 0.11, PB
HTMLIMAGE = , "(food)", "glyphs/png/food.png", 0.11, 0.11, PB
HTMLIMAGE = , "(indoors)", "glyphs/png/indoors.png", 0.11, 0.11, PB
HTMLIMAGE = , "(item)", "glyphs/png/item.png", 0.11, 0.11, PB
HTMLIMAGE = , "(relax)", "glyphs/png/relax.png", 0.11, 0.11, PB
HTMLIMAGE = , "(social)", "glyphs/png/social.png", 0.11, 0.11, PB
HTMLIMAGE = , "(fun)", "glyphs/png/fun.png", 0.11, 0.11, PB
HTMLIMAGE = , "(tree)", "glyphs/png/tree.png", 0.11, 0.11, PB

LINKCSV = UTF8
LINK = "the_nos_card_template_data.csv"

; Split the per-card Tags list into the three visible chip slots.
[tag1] = TOKENIZESEQ([Tags], 1, ~)
[tag2] = TOKENIZESEQ([Tags], 2, ~)
[tag3] = TOKENIZESEQ([Tags], 3, ~)

; Chip palette. Tags not listed here use the neutral default chip.
[chip_default] = #E9E6E0
[chip_outdoors] = #DCEFD2
[chip_indoors] = #E4E6E8
[chip_relax] = #F7DCE5
[chip_board_game] = #E7DDF7
[chip_item] = #D7EAF8
[chip_social] = #FFF0BF
[chip_food] = #FBE1C8
[chip_exercise] = #F7D2D2

; Base card.
RECTANGLE = , 0, 0, 2.74, 3.74, [paper]

; Full-bleed photo: it reaches the top and both side borders.
; PC keeps the aspect ratio and crops the excess to fill the frame.
; The badge is intentionally drawn later, so it sits over the photo.
IMAGE = , [Image], 0, 0, 2.74, 2.00, 0, PC

; Information panel.
; It is allowed to extend into the bleed because it is plain paper.
RECTANGLE = , 0, 2.00, 2.74, 1.74, [paper]

; Energy cost badge - top-left, over the image.
; Its entire bounding box is inside the safe area.
; Draw the dark-grey fill at 20% opacity, then the paper-colored outline.
LAYER = 20
ROUNDRECT = , 0.30, 0.30, 0.32, 0.32, [shade], [shade], 0.001, 0.06, 0.06, R
ENDLAYER
ROUNDRECT = , 0.30, 0.30, 0.32, 0.32, [paper], EMPTY, 0.012, 0.06, 0.06, R
FONT = Montserrat, 11, BT, [paper]
TEXT = , [Cost], 0.30, 0.30, 0.32, 0.32, center, center, 0, 100, , , , 100, 110

; Title, tags, effect, and flavor text.
; T makes the TEXT background transparent instead of the default white.
FONT = Montserrat, 13, BT, [ink]
TEXT = , [Title], 0.32, 2.04, 2.18, 0.20, left, center, 0, 100, , , , 100, 100

RECTANGLE = , 0.32, 2.4, 0.26, 0.015, [accent]

; Tags render as compact chips above the divider.  The neutral chip is drawn
; first, then a direct category match overwrites it with the requested color.
ROUNDRECT = LABELRANGE([tag1], <>), 0.32, 2.28, 0.52, 0.08, [chip_default], [chip_default], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], <>), 0.92, 2.28, 0.52, 0.08, [chip_default], [chip_default], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], <>), 1.52, 2.28, 0.52, 0.08, [chip_default], [chip_default], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Outdoors), 0.32, 2.28, 0.52, 0.08, [chip_outdoors], [chip_outdoors], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Indoors), 0.32, 2.28, 0.52, 0.08, [chip_indoors], [chip_indoors], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Relax), 0.32, 2.28, 0.52, 0.08, [chip_relax], [chip_relax], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Board Game), 0.32, 2.28, 0.52, 0.08, [chip_board_game], [chip_board_game], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Item), 0.32, 2.28, 0.52, 0.08, [chip_item], [chip_item], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Social), 0.32, 2.28, 0.52, 0.08, [chip_social], [chip_social], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Food), 0.32, 2.28, 0.52, 0.08, [chip_food], [chip_food], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag1], Exercise), 0.32, 2.28, 0.52, 0.08, [chip_exercise], [chip_exercise], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Outdoors), 0.92, 2.28, 0.52, 0.08, [chip_outdoors], [chip_outdoors], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Indoors), 0.92, 2.28, 0.52, 0.08, [chip_indoors], [chip_indoors], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Relax), 0.92, 2.28, 0.52, 0.08, [chip_relax], [chip_relax], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Board Game), 0.92, 2.28, 0.52, 0.08, [chip_board_game], [chip_board_game], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Item), 0.92, 2.28, 0.52, 0.08, [chip_item], [chip_item], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Social), 0.92, 2.28, 0.52, 0.08, [chip_social], [chip_social], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Food), 0.92, 2.28, 0.52, 0.08, [chip_food], [chip_food], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag2], Exercise), 0.92, 2.28, 0.52, 0.08, [chip_exercise], [chip_exercise], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Outdoors), 1.52, 2.28, 0.52, 0.08, [chip_outdoors], [chip_outdoors], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Indoors), 1.52, 2.28, 0.52, 0.08, [chip_indoors], [chip_indoors], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Relax), 1.52, 2.28, 0.52, 0.08, [chip_relax], [chip_relax], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Board Game), 1.52, 2.28, 0.52, 0.08, [chip_board_game], [chip_board_game], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Item), 1.52, 2.28, 0.52, 0.08, [chip_item], [chip_item], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Social), 1.52, 2.28, 0.52, 0.08, [chip_social], [chip_social], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Food), 1.52, 2.28, 0.52, 0.08, [chip_food], [chip_food], 0.001, 0.02, 0.02, R
ROUNDRECT = LABELRANGE([tag3], Exercise), 1.52, 2.28, 0.52, 0.08, [chip_exercise], [chip_exercise], 0.001, 0.02, 0.02, R
FONT = Montserrat, 4, BT, [ink]
TEXT = LABELRANGE([tag1], <>), [tag1], 0.32, 2.28, 0.52, 0.08, center, center, 0, 100, , , , 100, 100
TEXT = LABELRANGE([tag2], <>), [tag2], 0.92, 2.28, 0.52, 0.08, center, center, 0, 100, , , , 100, 100
TEXT = LABELRANGE([tag3], <>), [tag3], 1.52, 2.28, 0.52, 0.08, center, center, 0, 100, , , , 100, 100
TEXT = LABELRANGE([tag2], <>), ".", 0.86, 2.28, 0.04, 0.08, center, center, 0, 100, , , , 100, 100
TEXT = LABELRANGE([tag3], <>), ".", 1.46, 2.28, 0.04, 0.08, center, center, 0, 100, , , , 100, 100

; HTMLTEXT wraps long rules automatically and leaves room for future
; HTMLIMAGE/HTMLKEY replacements embedded in the Effect field.
HTMLTEXT = , [Effect], 0.32, 2.60, 2.18, 0.60, [paper], 0, ET, 100, effect_text

; Optional flavor text below the effect, set in italics.
HTMLTEXT = , [Flavor], 0.32, 3.14, 2.18, 0.36, [paper], 0, ET, 100, flavor_text

; Draw a quiet border on the safe-area boundary, last.
; It is decorative only; all critical content is inside it.
ROUNDRECT = , 0.22, 0.22, 2.30, 3.30, [ink], EMPTY, 0.015, 0.08, 0.08, R
